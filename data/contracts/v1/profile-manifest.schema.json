{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/contracts/v1/profile-manifest.schema.json",
  "title": "Manifesto do perfil de simulação",
  "type": "object",
  "required": ["profile", "version", "natureza", "contract_version", "contract_registry", "datasets"],
  "$defs": {
    "rawSourceRecord": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "query": {"type": ["string", "object"]},
        "retrieved_at": {"type": "string", "format": "date"},
        "retrieved_at_http": {"type": "string"},
        "api_start": {"type": "string"},
        "api_end": {"type": "string"},
        "time_standard": {"type": "string"},
        "value": {"type": "string"},
        "depths": {"type": "array", "items": {"type": "string"}},
        "sidecar": {"type": ["string", "null"]},
        "sidecar_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "normalized_municipality_rows": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "profile": {"type": "string"},
    "version": {"type": "string"},
    "natureza": {"type": "string", "enum": ["observada", "derivada", "mista"]},
    "contract_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "contract_registry": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "location": {
      "type": ["object", "null"],
      "properties": {
        "municipality": {"type": "string"},
        "uf": {"type": "string", "minLength": 2, "maxLength": 2},
        "ibge_code": {"type": ["string", "null"]},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "coordinate_basis": {"type": "string"}
      },
      "required": ["municipality", "uf"],
      "additionalProperties": false
    },
    "datasets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["origem", "responsavel", "frequencia", "unidade", "periodo", "resolucao", "qualidade"],
        "properties": {
          "origem": {"type": "string"},
          "responsavel": {"type": "string"},
          "frequencia": {"type": "string"},
          "unidade": {"type": "string"},
          "periodo": {"type": "string"},
          "resolucao": {"type": "string"},
          "qualidade": {"type": "string"},
          "sha256": {"type": ["string", "null"]},
          "contract_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "raw_sources": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/rawSourceRecord"},
          {"type": "array", "items": {"$ref": "#/$defs/rawSourceRecord"}}
        ]
      }
    }
  },
  "additionalProperties": false
}
