          "description": ""
        },
        {
          "path": "weather.relative_humidity",
          "type": "number [%] 0..100",
          "required": false,
          "description": "Pre-process step: derive the actual vapor pressure from temperature and pressure (task CL2 in docs/tasks/data-usage.md). NASA POWER RH2M is the direct source."
        },
        {
          "path": "weather.et0",
          "type": "number [mm/day] 0..",
          "required": false,
          "description": "Reference evapotranspiration. Computed in data/pipeline from NASA POWER (Penman-Monteith FAO-56; Hargreaves-Samani when solar radiation is missing). Drives the water balance with the crop Kc."
        }
      ]
