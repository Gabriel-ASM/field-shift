    {
      "id": "effect",
      "file": "effect.json",
      "title": "Effect on the simulation state",
      "comment": "An effect is NOT a state: it is a change applied to ONE variable of the state. Soil, climate and finances share this format; only 'target' changes. Monte Carlo applies effects, using the trajectory seed.",
      "definitions": [
        "quantity",
        "condition",
        "support"
      ],
      "fields": [
        {
          "path": "target",
          "type": "string",
          "required": true,
          "description": "JSON Pointer to the changed variable, relative to the chain node (markov.json#/definitions/node)."
        },
        {
          "path": "operation",
          "type": "enum: add | multiply | set | rate",
          "required": true,
          "description": "add: adds 'value' once. multiply: multiplies by 'value'. set: overwrites. rate: 'value' per day, multiplied by the days spent in the state/action."
        },
        {
          "path": "value",
          "type": "-> #/definitions/quantity",
          "required": true,
          "description": ""
        },
        {
          "path": "unit",
          "type": "string",
          "required": false,
          "description": "Unit of 'value'. For add/set it is the target unit; for rate it is target unit per day; multiply is dimensionless."
        },
        {
          "path": "at",
          "type": "enum: entry | exit",
          "required": false,
          "description": "When a one-off effect (add/multiply/set) fires inside a state: on entry (e.g. sowing cost) or on exit (e.g. harvest revenue). Ignored for operation=rate, which accumulates over the whole stay, and for effects on transitions, which fire when the edge is crossed."
        },
        {
          "path": "when",
          "type": "array of -> #/definitions/condition",
          "required": false,
          "description": "Conditions on the node (all must hold). Empty/absent = always applies."
        },
        {
          "path": "bounds",
          "type": "object",
          "required": false,
          "description": "Clamp applied to the target after the effect (e.g. N2 >= 0, 3 <= pH <= 9)."
        },
        {
          "path": "bounds.min",
          "type": "number",
          "required": false,
          "description": ""
        },
        {
          "path": "bounds.max",
          "type": "number",
          "required": false,
          "description": ""
        },
        {
          "path": "support",
          "type": "-> #/definitions/support",
          "required": true,
          "description": ""
        },
        {
          "path": "provenance",
          "type": "string",
          "required": false,
          "description": "Where the number comes from, specific enough to check it: a file and field, a dataset and query, a paper or a rule. Example: 'PAM municipal, year pair 2005-2006'."
        },
        {
          "path": "condition.path",
          "type": "string",
          "required": true,
          "description": "JSON Pointer into the node, like 'target'."
