{
    "$schema": "http://json-schema.org/draft-07/schema",
    "properties": {
        "name": {"type":"string"},
        "description": {"type":"string"},

        "stage_props":{
            "type":"object",
            "properties": {
                "soil_effect":   {"type":"soil"},
                "weather_effect":{"type":"weather"},
                "financial_effect": {"type":"financial"}
            }
        },
        "stage":{
            "type":"object",
            "properties": {
                "skip_stages":     {"type":"stage_props", "description": "This state should only be used if we don't have all information about the stages"},
                "preparation":     {"type":"stage_props"},
                "sowing":          {"type":"stage_props"},
                "germination":     {"type":"stage_props"},
                "growth":          {"type":"stage_props"},
                "flowering":       {"type":"stage_props"},
                "fruiting":        {"type":"stage_props"},
                "ripening":        {"type":"stage_props"},
                "harvesting":      {"type":"stage_props"},
                "post_harvesting": {"type":"stage_props"}
            }
        }

    }
}   