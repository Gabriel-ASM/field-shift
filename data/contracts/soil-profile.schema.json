{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/contracts/soil-profile.schema.json",
  "title": "Perfil estático de solo",
  "description": "Separar análise do talhão de estimativas de mapas e priors regionais. Cada valor informa profundidade, unidade, origem e qualidade.",
  "type": "object",
  "required": ["location_id", "scope", "reference_date", "source", "depth_cm", "available_water_capacity_mm", "quality", "layers"],
  "properties": {
    "location_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "enum": ["field", "municipality", "grid_cell"]},
    "reference_date": {"type": ["string", "null"], "format": "date"},
    "source": {"type": "string"},
    "depth_cm": {"type": "number", "exclusiveMinimum": 0},
    "available_water_capacity_mm": {"type": ["number", "null"], "minimum": 0},
    "texture_class": {"type": ["string", "null"]},
    "sand_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "silt_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "clay_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "ph_water": {"type": ["number", "null"], "minimum": 0, "maximum": 14},
    "organic_carbon_g_kg": {"type": ["number", "null"], "minimum": 0},
    "sibcs_order": {"type": ["string", "null"]},
    "available_water_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Estado inicial medido ou informado; não inferir apenas de mapas."},
    "sample_point": {"type": ["object", "null"], "properties": {"longitude": {"type": "number", "minimum": -180, "maximum": 180}, "latitude": {"type": "number", "minimum": -90, "maximum": 90}, "basis": {"type": "string"}}, "required": ["longitude", "latitude", "basis"], "additionalProperties": false},
    "layers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["depth_top_cm", "depth_bottom_cm", "sand_pct", "silt_pct", "clay_pct", "ph_water", "organic_carbon_g_kg", "available_water_capacity_mm"],
        "properties": {
          "depth_top_cm": {"type": "number", "minimum": 0},
          "depth_bottom_cm": {"type": "number", "exclusiveMinimum": 0},
          "sand_pct": {"type": "number", "minimum": 0, "maximum": 100},
          "silt_pct": {"type": "number", "minimum": 0, "maximum": 100},
          "clay_pct": {"type": "number", "minimum": 0, "maximum": 100},
          "ph_water": {"type": "number", "minimum": 0, "maximum": 14},
          "organic_carbon_g_kg": {"type": "number", "minimum": 0},
          "organic_matter_pct_for_pedotransfer": {"type": "number", "minimum": 0},
          "theta_33_volumetric": {"type": "number"},
          "theta_1500_volumetric": {"type": "number"},
          "available_water_fraction_volumetric": {"type": "number", "minimum": 0},
          "available_water_capacity_mm": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "quality": {
      "type": "object",
      "required": ["status", "flags"],
      "properties": {
        "status": {"type": "string", "enum": ["field_measured", "mapped_estimate", "assumption", "missing"]},
        "flags": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
