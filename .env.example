# Runtime settings of the API (and, through GET /config, of the front). Copy to .env or pass with `docker run -e`.

# Basemap tiles. Default: NASA GIBS Blue Marble (public, no key, detail up to zoom 8).
FIELD_SHIFT_BASEMAP_TILES=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/BlueMarble_ShadedRelief_Bathymetry/default/GoogleMapsCompatible_Level8/{z}/{y}/{x}.jpeg
FIELD_SHIFT_BASEMAP_MAX_ZOOM=8
FIELD_SHIFT_BASEMAP_ATTRIBUTION=NASA EOSDIS GIBS, Blue Marble

# Alternative used in docs/visualizacao2.html: Esri World Imagery (sharper, not NASA data, Esri terms of use apply).
#FIELD_SHIFT_BASEMAP_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
#FIELD_SHIFT_BASEMAP_MAX_ZOOM=18
#FIELD_SHIFT_BASEMAP_ATTRIBUTION=Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics

# Headless CMS with the storyboard (optional).
#FIELD_SHIFT_CMS_URL=http://start:3001

# Size of a run requested by the front.
FIELD_SHIFT_RUN_TRAJECTORIES=100000
FIELD_SHIFT_RUN_TRACKS=40

# Database (the single image sets these itself).
#FIELD_SHIFT_MONGO_URI=mongodb://localhost:27017
#FIELD_SHIFT_DB=field_shift
